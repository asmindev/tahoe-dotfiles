+bool AppMenuModel::tryApplyAtspiMenu(const QModelIndex &activeTaskIndex)
+{
+    if (!activeTaskIndex.isValid()) {
+        return false;
+    }
+
+    const qint64 pid = m_tasksModel->data(activeTaskIndex, TaskManager::AbstractTasksModel::AppPid).toLongLong();
+    QString appId = m_tasksModel->data(activeTaskIndex, TaskManager::AbstractTasksModel::AppId).toString();
+    if (appId.endsWith(QLatin1String(".desktop"))) {
+        appId.chop(8);
+    }
+    const QString appName = m_tasksModel->data(activeTaskIndex, TaskManager::AbstractTasksModel::AppName).toString();
+    const QString windowTitle = m_tasksModel->data(activeTaskIndex, Qt::DisplayRole).toString();
+
+    // Include the PID: multiple windows of the same application can have
+    // different accessibility trees (e.g. one Electron instance started with
+    // ACCESSIBILITY_ENABLED and another without).
+    QString key = appId;
+    if (key.isEmpty()) {
+        key = appName;
+    }
+    if (key.isEmpty()) {
+        key = windowTitle;
+    }
+    if (key.isEmpty()) {
+        return false;
+    }
+    key += QLatin1Char(':') + QString::number(pid);
+
+    if (m_atspiChecked && key == m_atspiKey) {
+        if (!m_atspiHasMenu || !m_atspiMenu) {
+            return false;
+        }
+        m_usingGenericMenu = false;
+        m_serviceName.clear();
+        m_menuObjectPath.clear();
+        m_serviceWatcher->setWatchedServices({});
+        m_importer.reset();
+        m_menu = m_atspiMenu.get();
+        setMenuAvailable(true);
+        setVisible(true);
+        Q_EMIT modelNeedsUpdate();
+        return true;
+    }
+
+    m_atspiKey = key;
+    m_atspiChecked = true;
+    m_atspiHasMenu = false;
+
+    const QDBusConnection bus = atspiBus();
+    if (!bus.isConnected()) {
+        return false;
+    }
+
+    QString service;
+    QString rootPath;
+    if (!findAtspiAppRoot(bus, pid, appId, appName, windowTitle, service, rootPath)) {
+        return false;
+    }
+
+    QString menuService;
+    QString menuPath;
+    if (!findAtspiMenu(bus, service, rootPath, windowTitle, menuService, menuPath)) {
+        return false;
+    }
+
+    std::unique_ptr<QMenu> menu(new QMenu());
+    buildAtspiMenu(bus, menuService, menuPath, QString(), menuService, menuPath, QStringList(), menu.get(), 0);
+    if (menu->isEmpty()) {
+        return false;
+    }
+
+    m_atspiMenu = std::move(menu);
+    m_atspiHasMenu = true;
+    m_usingGenericMenu = false;
+    m_serviceName.clear();
+    m_menuObjectPath.clear();
+    m_serviceWatcher->setWatchedServices({});
+    m_importer.reset();
+    m_menu = m_atspiMenu.get();
+    setMenuAvailable(true);
+    setVisible(true);
+    Q_EMIT modelNeedsUpdate();
+    return true;
+}
