+bool findDBusMenuForPid(qint64 pid, QString &serviceName, QString &objectPath)
+{
+    if (pid <= 0) {
+        return false;
+    }
+
+    QDBusConnectionInterface *bus = QDBusConnection::sessionBus().interface();
+    if (!bus) {
+        return false;
+    }
+
+    const QStringList names = bus->registeredServiceNames().value();
+    for (const QString &name : names) {
+        // Menu exporters live on unique connections. Skipping well-known
+        // names halves the number of round trips on a typical session bus.
+        if (!name.startsWith(QLatin1Char(':'))) {
+            continue;
+        }
+        const QDBusReply<uint> reply = bus->servicePid(name);
+        if (!reply.isValid() || static_cast<qint64>(reply.value()) != pid) {
+            continue;
+        }
+        const QString path = findDBusMenuObjectPath(name);
+        if (!path.isEmpty()) {
+            serviceName = name;
+            objectPath = path;
+            return true;
+        }
+    }
+    return false;
+}
+
+constexpr auto atspiConnectionName = "quickbarAtspi";
+
+QDBusConnection atspiBus()
+{
+    static const QDBusConnection connection = [] {
+        const QDBusMessage message = QDBusMessage::createMethodCall(QStringLiteral("org.a11y.Bus"),
+                                                                    QStringLiteral("/org/a11y/bus"),
+                                                                    QStringLiteral("org.a11y.Bus"),
+                                                                    QStringLiteral("GetAddress"));
+        const QDBusMessage reply = QDBusConnection::sessionBus().call(message, QDBus::Block, 500);
+        if (reply.type() != QDBusMessage::ReplyMessage || reply.arguments().isEmpty()) {
+            return QDBusConnection(QString::fromLatin1(atspiConnectionName));
+        }
+        return QDBusConnection::connectToBus(reply.arguments().first().toString(), QString::fromLatin1(atspiConnectionName));
+    }();
+    return connection;
+}
+
+QString atspiRole(const QDBusConnection &bus, const QString &service, const QString &path)
+{
+    const QDBusMessage reply =
+        bus.call(QDBusMessage::createMethodCall(service,
+                                                path,
+                                                QStringLiteral("org.a11y.atspi.Accessible"),
+                                                QStringLiteral("GetRoleName")),
+                 QDBus::Block,
+                 100);
+    if (reply.type() != QDBusMessage::ReplyMessage || reply.arguments().isEmpty()) {
+        return {};
+    }
+    return reply.arguments().first().toString();
+}
+
+QString atspiName(const QDBusConnection &bus, const QString &service, const QString &path)
+{
+    QDBusMessage message = QDBusMessage::createMethodCall(service,
+                                                          path,
+                                                          QStringLiteral("org.freedesktop.DBus.Properties"),
+                                                          QStringLiteral("Get"));
+    message << QStringLiteral("org.a11y.atspi.Accessible") << QStringLiteral("Name");
+    const QDBusMessage reply = bus.call(message, QDBus::Block, 100);
+    if (reply.type() != QDBusMessage::ReplyMessage || reply.arguments().isEmpty()) {
+        return {};
+    }
+    return qvariant_cast<QDBusVariant>(reply.arguments().first()).variant().toString();
+}
+
+QList<QPair<QString, QString>> atspiChildren(const QDBusConnection &bus, const QString &service, const QString &path)
+{
+    QList<QPair<QString, QString>> children;
+    const QDBusMessage reply =
+        bus.call(QDBusMessage::createMethodCall(service,
+                                                path,
+                                                QStringLiteral("org.a11y.atspi.Accessible"),
+                                                QStringLiteral("GetChildren")),
+                 QDBus::Block,
+                 100);
+    if (reply.type() != QDBusMessage::ReplyMessage || reply.arguments().isEmpty()) {
+        return children;
+    }
+
+    const QDBusArgument argument = qvariant_cast<QDBusArgument>(reply.arguments().first());
+    argument.beginArray();
+    while (!argument.atEnd()) {
+        argument.beginStructure();
+        QString childService;
+        QDBusObjectPath childPath;
+        argument >> childService >> childPath;
+        argument.endStructure();
+        children.append(qMakePair(childService, childPath.path()));
+    }
+    argument.endArray();
+    return children;
+}
+
+bool atspiHasAction(const QDBusConnection &bus, const QString &service, const QString &path)
+{
+    const QDBusMessage reply =
+        bus.call(QDBusMessage::createMethodCall(service,
+                                                path,
+                                                QStringLiteral("org.a11y.atspi.Action"),
+                                                QStringLiteral("GetActions")),
+                 QDBus::Block,
+                 100);
+    if (reply.type() != QDBusMessage::ReplyMessage || reply.arguments().isEmpty()) {
+        return false;
+    }
+    const QDBusArgument argument = qvariant_cast<QDBusArgument>(reply.arguments().first());
+    bool hasAction = false;
+    argument.beginArray();
+    while (!argument.atEnd()) {
+        argument.beginStructure();
+        QString name;
+        QString description;
+        QString key;
+        argument >> name >> description >> key;
+        argument.endStructure();
+        hasAction = true;
+    }
+    argument.endArray();
+    return hasAction;
+}
+
+void atspiDoAction(const QString &service, const QString &path)
+{
+    QDBusMessage message =
+        QDBusMessage::createMethodCall(service, path, QStringLiteral("org.a11y.atspi.Action"), QStringLiteral("DoAction"));
+    message << 0;
+    atspiBus().call(message, QDBus::Block, 500);
+}
+
+QString atspiMenuText(const QString &name)
+{
+    QString text = name;
+    text.remove(QLatin1Char('_'));
+    text = text.trimmed();
+
+    // Chromium/Electron appends the accelerator to the accessible name, e.g.
+    // "New Text File Ctrl+N". Keep only the label; the accelerator is not used
+    // by the panel menu.
+    static const QRegularExpression accelerator(
+        QStringLiteral("\\s+((Ctrl|Alt|Shift|Meta|Super|Cmd)\\+[^\\s]+)(\\s+(Ctrl|Alt|Shift|Meta|Super|Cmd)\\+[^\\s]+)*$"),
+        QRegularExpression::CaseInsensitiveOption);
+    text.remove(accelerator);
+    return text.trimmed();
+}
+
+bool atspiHasPopup(const QDBusConnection &bus, const QString &service, const QString &path)
+{
+    const QDBusMessage attributeReply =
+        bus.call(QDBusMessage::createMethodCall(service,
+                                                path,
+                                                QStringLiteral("org.a11y.atspi.Accessible"),
+                                                QStringLiteral("GetAttributes")),
+                 QDBus::Block,
+                 100);
+    if (attributeReply.type() == QDBusMessage::ReplyMessage && !attributeReply.arguments().isEmpty()) {
+        const QDBusArgument argument = qvariant_cast<QDBusArgument>(attributeReply.arguments().first());
+        QVariantMap attributes;
+        argument.beginMap();
+        while (!argument.atEnd()) {
+            argument.beginMapEntry();
+            QString key;
+            QString value;
+            argument >> key >> value;
+            argument.endMapEntry();
+            attributes.insert(key, value);
+        }
+        argument.endMap();
+
+        if (!attributes.value(QStringLiteral("haspopup")).toString().isEmpty()
+            || attributes.value(QStringLiteral("class")).toString().contains(QLatin1String("submenu"))) {
+            return true;
+        }
+    }
+
+    const QDBusMessage stateReply =
+        bus.call(QDBusMessage::createMethodCall(service,
+                                                path,
+                                                QStringLiteral("org.a11y.atspi.Accessible"),
+                                                QStringLiteral("GetState")),
+                 QDBus::Block,
+                 100);
+    if (stateReply.type() != QDBusMessage::ReplyMessage || stateReply.arguments().isEmpty()) {
+        return false;
+    }
+
+    const QDBusArgument argument = qvariant_cast<QDBusArgument>(stateReply.arguments().first());
+    argument.beginArray();
+    int word = 0;
+    bool hasPopup = false;
+    while (!argument.atEnd()) {
+        uint bits = 0;
+        argument >> bits;
+        if (word == 0 && (bits & (1u << 9))) { // ATSPI_STATE_EXPANDABLE
+            hasPopup = true;
+        }
+        if (word == 1 && (bits & (1u << (42 - 32)))) { // ATSPI_STATE_HAS_POPUP
+            hasPopup = true;
+        }
+        ++word;
+    }
+    argument.endArray();
+    return hasPopup;
+}
+
+bool atspiFindChildMenu(const QDBusConnection &bus,
+                        const QString &service,
+                        const QString &path,
+                        QString &menuService,
+                        QString &menuPath)
+{
+    for (const auto &child : atspiChildren(bus, service, path)) {
+        if (atspiRole(bus, child.first, child.second) == QLatin1String("menu")) {
+            menuService = child.first;
+            menuPath = child.second;
+            return true;
+        }
+    }
+    return false;
+}
+
+bool atspiIsShowing(const QDBusConnection &bus, const QString &service, const QString &path)
+{
+    const QDBusMessage reply =
+        bus.call(QDBusMessage::createMethodCall(service,
+                                                path,
+                                                QStringLiteral("org.a11y.atspi.Accessible"),
+                                                QStringLiteral("GetState")),
+                 QDBus::Block,
+                 100);
+    if (reply.type() != QDBusMessage::ReplyMessage || reply.arguments().isEmpty()) {
+        return false;
+    }
+
+    const QDBusArgument argument = qvariant_cast<QDBusArgument>(reply.arguments().first());
+    argument.beginArray();
+    int word = 0;
+    bool showing = false;
+    while (!argument.atEnd()) {
+        uint bits = 0;
+        argument >> bits;
+        if (word == 0 && (bits & (1u << 25))) { // ATSPI_STATE_SHOWING
+            showing = true;
+            break;
+        }
+        ++word;
+    }
+    argument.endArray();
+    return showing;
+}
+
+bool atspiFindChildByName(const QDBusConnection &bus,
+                          const QString &service,
+                          const QString &path,
+                          const QString &text,
+                          QString &childService,
+                          QString &childPath)
+{
+    for (const auto &child : atspiChildren(bus, service, path)) {
+        const QString role = atspiRole(bus, child.first, child.second);
+        if (role != QLatin1String("menu") && role != QLatin1String("menu item")
+            && role != QLatin1String("check menu item") && role != QLatin1String("radio menu item")) {
+            continue;
+        }
+        if (atspiMenuText(atspiName(bus, child.first, child.second)) == text) {
+            childService = child.first;
+            childPath = child.second;
+            return true;
+        }
+    }
+    return false;
+}
+
+bool appHasAccessibilityEnabled(qint64 pid)
+{
+    if (pid <= 0) {
+        return false;
+    }
+
+    QFile environ(QStringLiteral("/proc/%1/environ").arg(pid));
+    if (environ.open(QIODevice::ReadOnly)) {
+        const QByteArray data = environ.readAll();
+        const int key = data.indexOf("ACCESSIBILITY_ENABLED=");
+        if (key >= 0) {
+            const int valueStart = key + int(sizeof("ACCESSIBILITY_ENABLED=")) - 1;
+            int valueEnd = data.indexOf('\0', valueStart);
+            if (valueEnd < 0) {
+                valueEnd = data.size();
+            }
+            const QByteArray value = data.mid(valueStart, valueEnd - valueStart).toLower();
+            if (value == "1" || value == "true" || value == "yes") {
+                return true;
+            }
+        }
+    }
+
+    QFile cmdline(QStringLiteral("/proc/%1/cmdline").arg(pid));
+    if (cmdline.open(QIODevice::ReadOnly)) {
+        return cmdline.readAll().contains("--force-renderer-accessibility");
+    }
+    return false;
+}
+
+QString normalizedAtspiTitle(QString title)
+{
+    title = title.trimmed();
+    while (!title.isEmpty() && !title.front().isLetterOrNumber()) {
+        title.remove(0, 1);
+    }
+    return title;
+}
+
+bool findAtspiFrame(const QDBusConnection &bus,
+                    const QString &service,
+                    const QString &path,
+                    const QString &title,
+                    QString &frameService,
+                    QString &framePath,
+                    int depth)
+{
+    if (depth > 6) {
+        return false;
+    }
+
+    const QString role = atspiRole(bus, service, path);
+    if (role == QLatin1String("frame") || role == QLatin1String("window") || role == QLatin1String("dialog")) {
+        const QString frameName = normalizedAtspiTitle(atspiName(bus, service, path));
+        const QString wanted = normalizedAtspiTitle(title);
+        if (!frameName.isEmpty() && !wanted.isEmpty()
+            && (frameName == wanted || frameName.contains(wanted) || wanted.contains(frameName))) {
+            frameService = service;
+            framePath = path;
+            return true;
+        }
+    }
+
+    for (const auto &child : atspiChildren(bus, service, path)) {
+        if (findAtspiFrame(bus, child.first, child.second, title, frameService, framePath, depth + 1)) {
+            return true;
+        }
+    }
+    return false;
+}
+
+bool findAtspiMenuBar(const QDBusConnection &bus,
+                      const QString &service,
+                      const QString &path,
+                      QString &menuService,
+                      QString &menuPath,
+                      int depth)
+{
+    // Electron embeds the menu bar deep inside the window's accessibility
+    // tree (Chromium's Views tree is ~15 levels deep in VS Code).
+    if (depth > 20) {
+        return false;
+    }
+
+    if (atspiRole(bus, service, path) == QLatin1String("menu bar")) {
+        menuService = service;
+        menuPath = path;
+        return true;
+    }
+
+    for (const auto &child : atspiChildren(bus, service, path)) {
+        if (findAtspiMenuBar(bus, child.first, child.second, menuService, menuPath, depth + 1)) {
+            return true;
+        }
+    }
+    return false;
+}
+
+bool findAtspiMenu(const QDBusConnection &bus,
+                   const QString &appService,
+                   const QString &appRoot,
+                   const QString &windowTitle,
+                   QString &menuService,
+                   QString &menuPath)
+{
+    if (!windowTitle.isEmpty()) {
+        QString frameService;
+        QString framePath;
+        if (findAtspiFrame(bus, appService, appRoot, windowTitle, frameService, framePath, 0)
+            && findAtspiMenuBar(bus, frameService, framePath, menuService, menuPath, 0)) {
+            return true;
+        }
+    }
+
+    return findAtspiMenuBar(bus, appService, appRoot, menuService, menuPath, 0);
+}
+
+bool atspiWaitChildMenu(const QDBusConnection &bus,
+                        const QString &service,
+                        const QString &path,
+                        QString &menuService,
+                        QString &menuPath)
+{
+    for (int i = 0; i < 60; ++i) {
+        if (atspiFindChildMenu(bus, service, path, menuService, menuPath)) {
+            return true;
+        }
+        QThread::msleep(5);
+    }
+    return false;
+}
+
+bool atspiOpenPath(const QDBusConnection &bus,
+                   const QString &menuBarService,
+                   const QString &menuBarPath,
+                   const QString &topText,
+                   const QStringList &path,
+                   QString &menuService,
+                   QString &menuPath)
+{
+    QString itemService;
+    QString itemPath;
+    if (!atspiFindChildByName(bus, menuBarService, menuBarPath, topText, itemService, itemPath)) {
+        return false;
+    }
+
+    atspiDoAction(itemService, itemPath);
+    if (!atspiWaitChildMenu(bus, itemService, itemPath, menuService, menuPath)) {
+        return false;
+    }
+
+    for (const QString &name : path) {
+        if (!atspiFindChildByName(bus, menuService, menuPath, name, itemService, itemPath)) {
+            return false;
+        }
+        atspiDoAction(itemService, itemPath);
+        if (!atspiWaitChildMenu(bus, itemService, itemPath, menuService, menuPath)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+void atspiCloseTop(const QDBusConnection &bus,
+                   const QString &menuBarService,
+                   const QString &menuBarPath,
+                   const QString &topText)
+{
+    QString itemService;
+    QString itemPath;
+    if (!atspiFindChildByName(bus, menuBarService, menuBarPath, topText, itemService, itemPath)) {
+        return;
+    }
+
+    QString menuService;
+    QString menuPath;
+    if (atspiFindChildMenu(bus, itemService, itemPath, menuService, menuPath)
+        && atspiIsShowing(bus, menuService, menuPath)) {
+        atspiDoAction(itemService, itemPath);
+    }
+}
+
+bool atspiActivatePath(const QDBusConnection &bus,
+                       const QString &menuBarService,
+                       const QString &menuBarPath,
+                       const QString &topText,
+                       const QStringList &path)
+{
+    if (path.isEmpty()) {
+        return false;
+    }
+
+    QString itemService;
+    QString itemPath;
+    if (!atspiFindChildByName(bus, menuBarService, menuBarPath, topText, itemService, itemPath)) {
+        return false;
+    }
+
+    atspiDoAction(itemService, itemPath);
+    QString menuService;
+    QString menuPath;
+    if (!atspiWaitChildMenu(bus, itemService, itemPath, menuService, menuPath)) {
+        atspiCloseTop(bus, menuBarService, menuBarPath, topText);
+        return false;
+    }
+
+    for (int i = 0; i < path.size(); ++i) {
+        if (!atspiFindChildByName(bus, menuService, menuPath, path.at(i), itemService, itemPath)) {
+            atspiCloseTop(bus, menuBarService, menuBarPath, topText);
+            return false;
+        }
+        atspiDoAction(itemService, itemPath);
+        if (i + 1 < path.size() && !atspiWaitChildMenu(bus, itemService, itemPath, menuService, menuPath)) {
+            atspiCloseTop(bus, menuBarService, menuBarPath, topText);
+            return false;
+        }
+    }
+
+    atspiCloseTop(bus, menuBarService, menuBarPath, topText);
+    return true;
+}
+
+void buildAtspiMenu(const QDBusConnection &bus,
+                    const QString &menuBarService,
+                    const QString &menuBarPath,
+                    const QString &topText,
+                    const QString &service,
+                    const QString &path,
+                    const QStringList &prefix,
+                    QMenu *menu,
+                    int depth)
+{
+    if (!menu || depth > 8) {
+        return;
+    }
+
+    for (const auto &child : atspiChildren(bus, service, path)) {
+        const QString childService = child.first;
+        const QString childPath = child.second;
+        const QString role = atspiRole(bus, childService, childPath);
+
+        if (role == QLatin1String("separator")) {
+            menu->addSeparator();
+            continue;
+        }
+        if (role != QLatin1String("menu") && role != QLatin1String("menu item")
+            && role != QLatin1String("check menu item") && role != QLatin1String("radio menu item")) {
+            continue;
+        }
+
+        const QString text = atspiMenuText(atspiName(bus, childService, childPath));
+        if (text.isEmpty()) {
+            continue;
+        }
+
+        QAction *action = menu->addAction(text);
+
+        // When building the menu bar itself, every top-level item becomes the
+        // root of its own lazily loaded popup. Inside a popup, names are
+        // accumulated so an action can be replayed after the native menu has
+        // been closed and its accessibility objects have been destroyed.
+        const QString itemTopText = topText.isEmpty() ? text : topText;
+        QStringList itemPrefix;
+        if (!topText.isEmpty()) {
+            itemPrefix = prefix;
+            itemPrefix.append(text);
+        }
+
+        if (role == QLatin1String("menu")) {
+            QMenu *submenu = new QMenu(menu);
+            action->setMenu(submenu);
+            buildAtspiMenu(bus, menuBarService, menuBarPath, itemTopText, childService, childPath, itemPrefix, submenu, depth + 1);
+            if (submenu->isEmpty()) {
+                action->setEnabled(false);
+            }
+        } else if (atspiHasPopup(bus, childService, childPath)) {
+            QMenu *submenu = new QMenu(menu);
+            action->setMenu(submenu);
+            QAction *placeholder = submenu->addAction(QCoreApplication::translate("AppMenuModel", "Loading..."));
+            placeholder->setEnabled(false);
+
+            const QStringList openPath = itemPrefix;
+            QObject::connect(submenu,
+                             &QMenu::aboutToShow,
+                             submenu,
+                             [bus, menuBarService, menuBarPath, itemTopText, openPath, submenu, depth] {
+                                 QString menuService;
+                                 QString menuPath;
+                                 const bool opened = atspiOpenPath(bus,
+                                                                   menuBarService,
+                                                                   menuBarPath,
+                                                                   itemTopText,
+                                                                   openPath,
+                                                                   menuService,
+                                                                   menuPath);
+                                 submenu->clear();
+                                 if (opened) {
+                                     buildAtspiMenu(bus,
+                                                    menuBarService,
+                                                    menuBarPath,
+                                                    itemTopText,
+                                                    menuService,
+                                                    menuPath,
+                                                    openPath,
+                                                    submenu,
+                                                    depth + 1);
+                                 }
+                                 if (submenu->isEmpty()) {
+                                     QAction *empty = submenu->addAction(QCoreApplication::translate("AppMenuModel", "No menu items"));
+                                     empty->setEnabled(false);
+                                 }
+                                 atspiCloseTop(bus, menuBarService, menuBarPath, itemTopText);
+                             });
+
+            QObject::connect(submenu,
+                             &QMenu::aboutToHide,
+                             submenu,
+                             [bus, menuBarService, menuBarPath, itemTopText] {
+                                 atspiCloseTop(bus, menuBarService, menuBarPath, itemTopText);
+                             });
+        } else {
+            const bool enabled = atspiHasAction(bus, childService, childPath);
+            action->setEnabled(enabled);
+            if (enabled) {
+                const QStringList activatePath = itemPrefix;
+                QObject::connect(action,
+                                 &QAction::triggered,
+                                 action,
+                                 [bus, menuBarService, menuBarPath, itemTopText, activatePath] {
+                                     atspiActivatePath(bus,
+                                                       menuBarService,
+                                                       menuBarPath,
+                                                       itemTopText,
+                                                       activatePath);
+                                 });
+            }
+        }
+    }
+}
+
+bool findAtspiAppRoot(const QDBusConnection &bus,
+                      qint64 pid,
+                      const QString &appId,
+                      const QString &appName,
+                      const QString &windowTitle,
+                      QString &service,
+                      QString &rootPath)
+{
+    const QString registryService = QStringLiteral("org.a11y.atspi.Registry");
+    const QString registryPath = QStringLiteral("/org/a11y/atspi/accessible/root");
+    const auto apps = atspiChildren(bus, registryService, registryPath);
+
+    for (const auto &app : apps) {
+        if (pid > 0) {
+            QDBusMessage pidMessage = QDBusMessage::createMethodCall(QStringLiteral("org.freedesktop.DBus"),
+                                                                      QStringLiteral("/org/freedesktop/DBus"),
+                                                                      QStringLiteral("org.freedesktop.DBus"),
+                                                                      QStringLiteral("GetConnectionUnixProcessID"));
+            pidMessage << app.first;
+            const QDBusMessage pidReply = bus.call(pidMessage, QDBus::Block, 100);
+            if (pidReply.type() == QDBusMessage::ReplyMessage && !pidReply.arguments().isEmpty()
+                && static_cast<qint64>(pidReply.arguments().first().toUInt()) == pid) {
+                service = app.first;
+                rootPath = app.second;
+                return true;
+            }
+        }
+
+        const QString name = atspiName(bus, app.first, app.second);
+        if ((!appId.isEmpty() && name.compare(appId, Qt::CaseInsensitive) == 0)
+            || (!appName.isEmpty() && name.compare(appName, Qt::CaseInsensitive) == 0)) {
+            service = app.first;
+            rootPath = app.second;
+            return true;
+        }
+    }
+
+    if (windowTitle.isEmpty()) {
+        return false;
+    }
+
+    for (const auto &app : apps) {
+        QString frameService;
+        QString framePath;
+        if (findAtspiFrame(bus, app.first, app.second, windowTitle, frameService, framePath, 0)) {
+            service = app.first;
+            rootPath = app.second;
+            return true;
+        }
+    }
+    return false;
+}
