+QString findDBusMenuObjectPath(const QString &serviceName)
+{
+    const QDBusConnection bus = QDBusConnection::sessionBus();
+
+    const auto hasMenu = [&bus, &serviceName](const QString &path) {
+        QDBusMessage message = QDBusMessage::createMethodCall(serviceName,
+                                                              path,
+                                                              QStringLiteral("org.freedesktop.DBus.Properties"),
+                                                              QStringLiteral("Get"));
+        message << QStringLiteral("com.canonical.dbusmenu") << QStringLiteral("Version");
+        const QDBusMessage reply = bus.call(message, QDBus::Block, 100);
+        return reply.type() == QDBusMessage::ReplyMessage && !reply.arguments().isEmpty();
+    };
+
+    // Chromium/Electron exports its menu under /com/canonical/menu/<id>, and
+    // libdbusmenu-based applications use the same prefix (sometimes with an
+    // X11 window id). Probe a small range plus a couple of fallbacks.
+    for (int id = 0; id < 16; ++id) {
+        const QString path = QStringLiteral("/com/canonical/menu/%1").arg(id);
+        if (hasMenu(path)) {
+            return path;
+        }
+    }
+    for (const QString &path : {QStringLiteral("/MenuBar"), QStringLiteral("/com/canonical/menu/0x0")}) {
+        if (hasMenu(path)) {
+            return path;
+        }
+    }
+    return {};
+}
+
+bool findDBusMenuForPid(qint64 pid, QString &serviceName, QString &objectPath)
+{
+    if (pid <= 0) {
+        return false;
+    }
+
+    QDBusConnectionInterface *bus = QDBusConnection::sessionBus().interface();
+    if (!bus) {
+        return false;
+    }
+
+    const QStringList names = bus->registeredServiceNames().value();
+    for (const QString &name : names) {
+        // Menu exporters live on unique connections. Skipping well-known
+        // names halves the number of round trips on a typical session bus.
+        if (!name.startsWith(QLatin1Char(':'))) {
+            continue;
+        }
+        const QDBusReply<uint> reply = bus->servicePid(name);
+        if (!reply.isValid() || static_cast<qint64>(reply.value()) != pid) {
+            continue;
+        }
+        const QString path = findDBusMenuObjectPath(name);
+        if (!path.isEmpty()) {
+            serviceName = name;
+            objectPath = path;
+            return true;
+        }
+    }
+    return false;
+}
 } // namespace
 
