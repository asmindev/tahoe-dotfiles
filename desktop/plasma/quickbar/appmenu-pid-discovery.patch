+bool AppMenuModel::tryDiscoverApplicationMenu(const QModelIndex &activeTaskIndex, QString &serviceName, QString &objectPath)
+{
+    const qint64 pid = m_tasksModel->data(activeTaskIndex, TaskManager::AbstractTasksModel::AppPid).toLongLong();
+    if (pid <= 0) {
+        return false;
+    }
+
+    const QDBusConnectionInterface *bus = QDBusConnection::sessionBus().interface();
+    if (!bus) {
+        return false;
+    }
+
+    auto cached = m_discoveredMenus.find(pid);
+    if (cached != m_discoveredMenus.end()) {
+        const QPair<QString, QString> location = cached.value();
+        if (bus->isServiceRegistered(location.first)) {
+            serviceName = location.first;
+            objectPath = location.second;
+            return true;
+        }
+        m_discoveredMenus.erase(cached);
+    }
+
+    if (!findDBusMenuForPid(pid, serviceName, objectPath)) {
+        return false;
+    }
+
+    m_discoveredMenus.insert(pid, qMakePair(serviceName, objectPath));
+    return true;
+}
