+bool isStatusNotifierMenuPath(const QString &path)
+{
+    // StatusNotifierItem/AppIndicator exports its tray context menu through
+    // com.canonical.dbusmenu as well. That menu is not the application menu and
+    // must not be picked up by the fallback discovery.
+    return path.startsWith(QLatin1String("/org/ayatana/NotificationItem"))
+        || path.startsWith(QLatin1String("/org/kde/StatusNotifierItem"))
+        || path.startsWith(QLatin1String("/StatusNotifierItem"));
+}
+
+QString findDBusMenuObjectPath(const QString &serviceName)
+{
+    const QDBusConnection bus = QDBusConnection::sessionBus();
+
+    const auto hasMenu = [&bus, &serviceName](const QString &path) {
+        if (isStatusNotifierMenuPath(path)) {
+            return false;
+        }
+        QDBusMessage message = QDBusMessage::createMethodCall(serviceName,
+                                                              path,
+                                                              QStringLiteral("org.freedesktop.DBus.Properties"),
+                                                              QStringLiteral("Get"));
+        message << QStringLiteral("com.canonical.dbusmenu") << QStringLiteral("Version");
+        const QDBusMessage reply = bus.call(message, QDBus::Block, 100);
+        return reply.type() == QDBusMessage::ReplyMessage && !reply.arguments().isEmpty();
+    };
+
+    // Chromium/Electron exports its menu under /com/canonical/menu/<id>, and
+    // libdbusmenu-based applications use the same prefix (sometimes with an
+    // X11 window id). Probe a small range plus a couple of fallbacks.
+    for (int id = 0; id < 16; ++id) {
+        const QString path = QStringLiteral("/com/canonical/menu/%1").arg(id);
+        if (hasMenu(path)) {
+            return path;
+        }
+    }
+    for (const QString &path : {QStringLiteral("/MenuBar"), QStringLiteral("/com/canonical/menu/0x0")}) {
+        if (hasMenu(path)) {
+            return path;
+        }
+    }
+
+    // Fall back to walking the service object tree. Some toolkits export the
+    // menu at a non-standard path, so hardcoding /com/canonical/menu is not
+    // enough. Bounded depth/node count keeps this cheap on the session bus.
+    struct Node {
+        QString path;
+        int depth;
+    };
+    QVector<Node> pending;
+    pending.append({QStringLiteral("/"), 0});
+    int inspected = 0;
+    while (!pending.isEmpty() && inspected < 64) {
+        const Node node = pending.takeLast();
+        if (node.depth > 4) {
+            continue;
+        }
+        ++inspected;
+
+        QDBusMessage message = QDBusMessage::createMethodCall(serviceName,
+                                                              node.path,
+                                                              QStringLiteral("org.freedesktop.DBus.Introspectable"),
+                                                              QStringLiteral("Introspect"));
+        const QDBusMessage reply = bus.call(message, QDBus::Block, 100);
+        if (reply.type() != QDBusMessage::ReplyMessage || reply.arguments().isEmpty()) {
+            continue;
+        }
+
+        QXmlStreamReader reader(reply.arguments().first().toString());
+        bool hasDBusMenu = false;
+        QStringList children;
+        int xmlDepth = 0;
+        while (!reader.atEnd()) {
+            const QXmlStreamReader::TokenType token = reader.readNext();
+            if (token == QXmlStreamReader::StartElement) {
+                ++xmlDepth;
+                if (xmlDepth == 2) {
+                    if (reader.name() == QLatin1String("interface")) {
+                        if (reader.attributes().value(QLatin1String("name")) == QLatin1String("com.canonical.dbusmenu")) {
+                            hasDBusMenu = true;
+                        }
+                    } else if (reader.name() == QLatin1String("node")) {
+                        const QString name = reader.attributes().value(QLatin1String("name")).toString();
+                        if (!name.isEmpty() && !name.startsWith(QLatin1Char('/'))) {
+                            children.append(node.path == QLatin1String("/") ? QLatin1Char('/') + name
+                                                                            : node.path + QLatin1Char('/') + name);
+                        }
+                    }
+                }
+            } else if (token == QXmlStreamReader::EndElement) {
+                --xmlDepth;
+            }
+        }
+
+        if (hasDBusMenu && !isStatusNotifierMenuPath(node.path)) {
+            return node.path;
+        }
+        if (node.depth < 4) {
+            for (const QString &child : children) {
+                pending.append({child, node.depth + 1});
+            }
+        }
+    }
+
+    return {};
+}
